generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                String           @id @default(uuid())
  email             String           @unique
  passwordHash      String
  fullName          String
  phone             String?
  country           String           @default("Cameroon")
  region            String?
  city              String?
  role              AppRole          @default(buyer)
  referralCode      String?
  language          String           @default("en")
  preferredCurrency String           @default("XAF")
  avatarUrl         String?
  kycStatus         KycStatus        @default(not_submitted)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  lastLoginAt       DateTime?
  lastDeviceHash    String?
  otpCode           String?
  otpExpiresAt      DateTime?
  status            users_status?    @default(active)
  warningCount      Int?             @default(0)
  otp_code          String?          @db.VarChar(6)
  otp_expires_at    DateTime?        @db.DateTime(0)
  is_verified       Boolean?         @default(false)
  isVerified        Boolean          @default(false)
  bargainsAsBuyer   Bargain[]        @relation("BuyerBargains")
  bargainsAsSeller  Bargain[]        @relation("SellerBargains")
  kycVerification   KycVerification?
  listings          Listing[]        @relation("SellerListings")
  ordersAsBuyer     Order[]          @relation("BuyerOrders")
  ordersAsSeller    Order[]          @relation("SellerOrders")
  reviewsGiven      Review[]         @relation("ReviewsGiven")
  reviewsReceived   Review[]         @relation("ReviewsReceived")
  wallet            Wallet?

  @@map("users")
}

model KycVerification {
  id              String    @id @default(uuid())
  userId          String    @unique
  documentType    String
  documentNumber  String
  documentUrl     String?
  status          KycStatus @default(pending)
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("kyc_verifications")
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  icon        String?
  createdAt   DateTime  @default(now())
  listings    Listing[]

  @@map("categories")
}

model Listing {
  id          String        @id @default(uuid())
  title       String
  description String        @db.Text
  price       Float
  currency    String        @default("XAF")
  quantity    Int           @default(1)
  unit        String        @default("pcs")
  region      String
  city        String?
  status      ListingStatus @default(active)
  images      Json?
  categoryId  String
  sellerId    String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  bargains    Bargain[]
  category    Category      @relation(fields: [categoryId], references: [id])
  seller      User          @relation("SellerListings", fields: [sellerId], references: [id], onDelete: Cascade)
  orders      Order[]
  reviews     Review[]

  @@index([categoryId], map: "listings_categoryId_fkey")
  @@index([sellerId], map: "listings_sellerId_fkey")
  @@map("listings")
}

model Order {
  id           String      @id @default(uuid())
  orderNumber  String      @unique
  listingId    String
  buyerId      String
  sellerId     String
  quantity     Int         @default(1)
  totalPrice   Float
  currency     String      @default("XAF")
  status       OrderStatus @default(pending)
  shippingCity String?
  shippingAddr String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  buyer        User        @relation("BuyerOrders", fields: [buyerId], references: [id])
  listing      Listing     @relation(fields: [listingId], references: [id])
  seller       User        @relation("SellerOrders", fields: [sellerId], references: [id])

  @@index([buyerId], map: "orders_buyerId_fkey")
  @@index([listingId], map: "orders_listingId_fkey")
  @@index([sellerId], map: "orders_sellerId_fkey")
  @@map("orders")
}

model Bargain {
  id           String        @id @default(uuid())
  listingId    String
  buyerId      String
  sellerId     String
  offeredPrice Float
  status       BargainStatus @default(pending)
  counterPrice Float?
  message      String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  buyer        User          @relation("BuyerBargains", fields: [buyerId], references: [id])
  listing      Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  seller       User          @relation("SellerBargains", fields: [sellerId], references: [id])

  @@index([buyerId], map: "bargains_buyerId_fkey")
  @@index([listingId], map: "bargains_listingId_fkey")
  @@index([sellerId], map: "bargains_sellerId_fkey")
  @@map("bargains")
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  balance   Float    @default(0)
  currency  String   @default("XAF")
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

model Review {
  id         String   @id @default(uuid())
  listingId  String
  reviewerId String
  sellerId   String
  rating     Int
  comment    String?  @db.Text
  createdAt  DateTime @default(now())
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reviewer   User     @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  seller     User     @relation("ReviewsReceived", fields: [sellerId], references: [id])

  @@index([listingId], map: "reviews_listingId_fkey")
  @@index([reviewerId], map: "reviews_reviewerId_fkey")
  @@index([sellerId], map: "reviews_sellerId_fkey")
  @@map("reviews")
}

model admin_activity_logs {
  id           Int       @id @default(autoincrement())
  adminId      String    @db.VarChar(36)
  targetUserId String?   @db.VarChar(36)
  action       String    @db.VarChar(255)
  details      String?   @db.Text
  createdAt    DateTime? @default(now()) @db.DateTime(0)

  @@index([adminId], map: "adminId")
}

model bargain_deals {
  id              Int       @id @default(autoincrement())
  title           String    @db.VarChar(255)
  price           Decimal   @db.Decimal(10, 2)
  originalPrice   Decimal   @db.Decimal(10, 2)
  discountPercent String?   @default("-30%") @db.VarChar(20)
  imageUrl        String?   @db.Text
  region          String?   @default("Littoral") @db.VarChar(100)
  sellerName      String?   @default("Verified Producer") @db.VarChar(255)
  isLive          Boolean?  @default(true)
  created_at      DateTime? @default(now()) @db.DateTime(0)
}

model card_transactions {
  id        String    @id @db.VarChar(100)
  cardId    String    @db.VarChar(100)
  amount    Decimal   @db.Decimal(10, 2)
  currency  String?   @default("XAF") @db.VarChar(10)
  merchant  String    @db.VarChar(255)
  status    String?   @default("completed") @db.VarChar(50)
  createdAt DateTime? @default(now()) @db.DateTime(0)
  cards     cards     @relation(fields: [cardId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "card_transactions_ibfk_1")

  @@index([cardId], map: "cardId")
}

model cards {
  id                String              @id @db.VarChar(100)
  userId            String              @db.VarChar(100)
  card_number       String              @db.VarChar(100)
  card_holder_name  String              @db.VarChar(255)
  expiry_date       String              @db.VarChar(20)
  cvv               String              @db.VarChar(10)
  type              String?             @default("virtual") @db.VarChar(50)
  createdAt         DateTime?           @default(now()) @db.DateTime(0)
  status            String?             @default("active") @db.VarChar(50)
  card_transactions card_transactions[]
}

model cloudinary_settings {
  id        Int       @id @default(autoincrement())
  cloudName String    @db.VarChar(255)
  apiKey    String    @db.VarChar(255)
  apiSecret String    @db.VarChar(255)
  updatedAt DateTime? @default(now()) @db.DateTime(0)
}

model course_enrollments {
  id            String    @id @db.VarChar(100)
  courseId      String    @db.VarChar(100)
  courseTitle   String    @db.VarChar(255)
  name          String    @db.VarChar(255)
  email         String    @db.VarChar(255)
  phone         String?   @db.VarChar(100)
  paymentStatus String?   @default("free") @db.VarChar(50)
  amountPaid    String?   @default("0 FCFA") @db.VarChar(100)
  createdAt     DateTime? @default(now()) @db.DateTime(0)
}

model course_exam_questions {
  id            String    @id @db.VarChar(100)
  examId        String    @db.VarChar(100)
  questionType  String?   @default("multiple_choice") @db.VarChar(50)
  questionText  String    @db.Text
  options       String?   @db.Text
  correctAnswer String    @db.Text
  orderIndex    Int?      @default(0)
  createdAt     DateTime? @default(now()) @db.DateTime(0)
}

model course_exams {
  id        String    @id @db.VarChar(100)
  courseId  String    @db.VarChar(100)
  title     String    @db.VarChar(255)
  passScore Int?      @default(80)
  createdAt DateTime? @default(now()) @db.DateTime(0)
}

model course_sections {
  id         String    @id @db.VarChar(100)
  courseId   String    @db.VarChar(100)
  title      String    @db.VarChar(255)
  orderIndex Int?      @default(0)
  createdAt  DateTime? @default(now()) @db.DateTime(0)
}

model course_topics {
  id           String    @id @db.VarChar(100)
  sectionId    String    @db.VarChar(100)
  title        String    @db.VarChar(255)
  description  String?   @db.Text
  materialUrl  String?   @db.Text
  materialType String?   @db.VarChar(50)
  orderIndex   Int?      @default(0)
  createdAt    DateTime? @default(now()) @db.DateTime(0)
}

model courses {
  id                   String    @id @db.VarChar(100)
  title                String    @db.VarChar(255)
  category             String?   @default("business") @db.VarChar(100)
  instructor           String?   @default("Camer Market Academy Instructor") @db.VarChar(255)
  level                String?   @default("All Levels") @db.VarChar(50)
  duration             String?   @default("4 Weeks") @db.VarChar(50)
  price                String?   @default("Free Access") @db.VarChar(100)
  image                String    @db.Text
  description          String?   @db.Text
  videoUrl             String?   @db.Text
  certParticipationUrl String?   @db.Text
  certCompletionUrl    String?   @db.Text
  createdAt            DateTime? @default(now()) @db.DateTime(0)
}

model delivery_fees {
  id          Int       @id @default(autoincrement())
  standardFee Decimal?  @default(1000.00) @db.Decimal(10, 2)
  expressFee  Decimal?  @default(2500.00) @db.Decimal(10, 2)
  pickupFee   Decimal?  @default(0.00) @db.Decimal(10, 2)
  updatedAt   DateTime? @db.DateTime(0)
}

model forum_registrations {
  id             String    @id @db.VarChar(100)
  name           String    @db.VarChar(255)
  email          String    @db.VarChar(255)
  phone          String    @db.VarChar(100)
  organization   String?   @db.VarChar(255)
  address        String?   @db.VarChar(255)
  city           String?   @db.VarChar(100)
  country        String?   @default("Cameroon") @db.VarChar(100)
  postalCode     String?   @db.VarChar(50)
  category       String?   @default("Standard") @db.VarChar(100)
  payment_status String?   @default("pending") @db.VarChar(50)
  amount_paid    String?   @default("0 XAF") @db.VarChar(100)
  registered_at  DateTime? @default(now()) @db.DateTime(0)
}

model notifications {
  id        String    @id
  userId    String
  title     String
  message   String    @db.Text
  isRead    Boolean?  @default(false)
  createdAt DateTime? @default(now())
}

model offline_transactions {
  id               String    @id @db.VarChar(100)
  transactionHash  String    @db.VarChar(255)
  merchantId       String    @db.VarChar(100)
  merchantName     String    @db.VarChar(255)
  buyerId          String    @db.VarChar(100)
  buyerName        String    @db.VarChar(255)
  amount           Decimal   @db.Decimal(12, 2)
  currency         String?   @default("XAF") @db.VarChar(10)
  offlineModeLevel String?   @default("Level 2: Dual Offline") @db.VarChar(50)
  gpsCoordinates   String?   @default("4.0511° N, 9.7679° E (Douala)") @db.VarChar(100)
  nonce            String    @db.VarChar(100)
  syncStatus       String?   @default("Pending Sync") @db.VarChar(50)
  settlementStatus String?   @default("Pending Settlement") @db.VarChar(50)
  createdAt        DateTime? @default(now()) @db.DateTime(0)
}

model offline_wallets {
  id                     String    @id @db.VarChar(100)
  userId                 String    @db.VarChar(100)
  onlineBalance          Decimal?  @default(250000.00) @db.Decimal(12, 2)
  offlineReservedBalance Decimal?  @default(25000.00) @db.Decimal(12, 2)
  tierLevel              String?   @default("Tier 1 Merchant") @db.VarChar(50)
  maxOfflineLimit        Decimal?  @default(50000.00) @db.Decimal(12, 2)
  spendingScore          Int?      @default(85)
  deviceCertificate      String?   @default("CERT-CAMEMARK-OFFLINE-DEVICETRUST-8823") @db.VarChar(255)
  updatedAt              DateTime? @default(now()) @db.DateTime(0)
}

model products {
  id            String    @id @default(dbgenerated("(uuid())")) @db.VarChar(36)
  sellerId      String
  title         String
  description   String?   @db.Text
  price         Decimal   @db.Decimal(10, 2)
  currency      String?   @default("XAF") @db.VarChar(10)
  quantity      Int?      @default(1)
  unit          String?   @default("pcs") @db.VarChar(50)
  category      String?   @default("Agriculture & Produce") @db.VarChar(100)
  region        String?   @default("Littoral") @db.VarChar(50)
  city          String?   @default("Douala") @db.VarChar(100)
  imageUrl      String?   @db.LongText
  status        String?   @default("active") @db.VarChar(20)
  createdAt     DateTime? @default(now())
  rating        String?   @db.VarChar(50)
  badge         String?   @db.VarChar(50)
  isBargainable Boolean?  @default(false)
  sellerName    String?
}

model referral_settings {
  id            Int       @id @default(autoincrement())
  setting_key   String    @unique(map: "setting_key") @db.VarChar(100)
  setting_value String    @db.VarChar(255)
  updated_at    DateTime? @default(now()) @db.Timestamp(0)
}

model referrals {
  id                  Int       @id @default(autoincrement())
  referrer_id         String    @db.VarChar(100)
  referrer_name       String    @db.VarChar(255)
  referrer_email      String?   @db.VarChar(255)
  ref_code            String    @db.VarChar(100)
  referred_user_id    String?   @db.VarChar(100)
  referred_user_name  String?   @db.VarChar(255)
  referred_user_email String?   @db.VarChar(255)
  reward_amount       Decimal?  @default(20.00) @db.Decimal(10, 2)
  status              String?   @default("completed") @db.VarChar(50)
  created_at          DateTime? @default(now()) @db.Timestamp(0)
}

model roles_permissions {
  id        String    @id @db.VarChar(100)
  role      String    @unique(map: "role") @db.VarChar(100)
  modules   String    @db.Text
  updatedAt DateTime? @default(now()) @db.DateTime(0)
}

model saved_items {
  id         Int       @id @default(autoincrement())
  user_id    String    @db.VarChar(100)
  product_id Int
  created_at DateTime? @default(now()) @db.Timestamp(0)

  @@unique([user_id, product_id], map: "unique_save")
}

model seller_payouts {
  id            String    @id @db.VarChar(100)
  sellerId      String    @db.VarChar(100)
  sellerName    String?   @default("Verified Merchant") @db.VarChar(255)
  amount        Decimal   @db.Decimal(12, 2)
  currency      String?   @default("XAF") @db.VarChar(10)
  method        String    @db.VarChar(100)
  accountNumber String    @db.VarChar(100)
  accountHolder String    @db.VarChar(255)
  status        String?   @default("Completed") @db.VarChar(50)
  createdAt     DateTime? @default(now()) @db.DateTime(0)
}

model smtp_settings {
  id        Int       @id @default(autoincrement())
  smtpHost  String?   @db.VarChar(255)
  smtpPort  String?   @db.VarChar(10)
  smtpUser  String?   @db.VarChar(255)
  smtpPass  String?   @db.VarChar(255)
  updatedAt DateTime? @db.DateTime(0)
}

model support_tickets {
  id            String                  @id @db.VarChar(100)
  userId        String
  cardId        String?                 @db.VarChar(100)
  transactionId String?                 @db.VarChar(100)
  subject       String                  @db.VarChar(255)
  message       String                  @db.Text
  adminResponse String?                 @db.Text
  status        support_tickets_status? @default(open)
  createdAt     DateTime?               @default(now()) @db.DateTime(0)
  updatedAt     DateTime?               @default(now()) @db.DateTime(0)
}

model user_activity_logs {
  id        Int       @id @default(autoincrement())
  userId    String    @db.VarChar(255)
  action    String    @db.VarChar(50)
  details   String?   @db.Text
  createdAt DateTime? @default(now()) @db.DateTime(0)

  @@index([userId(length: 250)], map: "userId")
}

model user_certificates {
  id             String    @id @db.VarChar(100)
  userId         String    @db.VarChar(100)
  courseId       String    @db.VarChar(100)
  type           String    @db.VarChar(50)
  certificateUrl String?   @db.Text
  issuedAt       DateTime? @default(now()) @db.DateTime(0)
}

model user_progress {
  id          String    @id @db.VarChar(100)
  userId      String    @db.VarChar(100)
  courseId    String    @db.VarChar(100)
  sectionId   String?   @db.VarChar(100)
  topicId     String?   @db.VarChar(100)
  status      String?   @default("completed") @db.VarChar(50)
  completedAt DateTime? @default(now()) @db.DateTime(0)
}

enum AppRole {
  buyer
  seller
  farmer
  service
  logistics
  diaspora
  org
  admin
}

enum OrderStatus {
  pending
  confirmed
  shipped
  delivered
  cancelled
}

enum ListingStatus {
  active
  draft
  sold
  archived
}

enum KycStatus {
  pending
  approved
  rejected
  not_submitted
}

enum BargainStatus {
  pending
  accepted
  rejected
  countered
}

enum support_tickets_status {
  open
  resolved
}

enum users_status {
  active
  banned
}
